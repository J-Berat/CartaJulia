#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

# Multi-threading by default — Makie / FFTW / FITSIO all benefit.
# Respect a user-provided override.
: "${JULIA_NUM_THREADS:=auto}"
export JULIA_NUM_THREADS

# --startup-file=no skips ~/.julia/config/startup.jl, which often loads heavy
# packages (Revise, OhMyREPL, …) that we do NOT need to view a FITS file and
# that add 1–3 s of latency at every launch.
JULIA_FLAGS=(--project --startup-file=no)

# `--setup` forces a full `Pkg.instantiate()` + add missing runtime deps +
# precompile. We do NOT call instantiate on the hot path: when the Manifest
# is already resolved (the common case), it's a 0.5–2 s tax for nothing.
if [[ "${1:-}" == "--setup" ]]; then
  julia "${JULIA_FLAGS[@]}" scripts/setup.jl
  shift || true
fi

if [[ $# -eq 0 ]]; then
  exec julia "${JULIA_FLAGS[@]}" demo/run_demo.jl
fi

exec julia "${JULIA_FLAGS[@]}" -e '
push!(LOAD_PATH, "src")
using MANTA

fits_path = abspath(ARGS[1])
fig = MANTA.manta(fits_path; cmap=:magma, invert=false)
display(fig)
while isopen(fig.scene)
    sleep(0.1)
end
' "$1"
